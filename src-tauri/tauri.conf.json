{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortHop",
  "version": "0.1.0",
  "identifier": "com.porthop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PortHop",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/porthop-cloudflared"
    ],
    "category": "DeveloperTool",
    "publisher": "Mayank Jonwal",
    "license": "MIT",
    "homepage": "https://github.com/mayankjonwal02/Porthop",
    "shortDescription": "localhost:3000 \u2192 app.yourdomain.com in one hop",
    "longDescription": "PortHop puts apps running on your computer on your own domain through a Cloudflare Tunnel, with no router ports opened.",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_OUTPUT_OF_tauri_signer_generate",
      "endpoints": [
        "https://github.com/mayankjonwal02/Porthop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}