{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunnelPup",
  "version": "0.2.0",
  "identifier": "io.github.mayankjonwal02.tunnelpup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TunnelPup",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tunnelpup-cloudflared"
    ],
    "category": "DeveloperTool",
    "publisher": "Mayank Jonwal",
    "copyright": "Copyright © 2026 Mayank Jonwal",
    "license": "MIT",
    "homepage": "https://github.com/mayankjonwal02/Tunnelpup",
    "shortDescription": "localhost:3000 \u2192 app.yourdomain.com in one hop",
    "longDescription": "TunnelPup puts apps running on your computer on your own domain through a Cloudflare Tunnel, with no router ports opened.",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFENkIyQ0VFRjM0MDI0MkEKUldRcUpFRHo3aXhycllBUlduczVtUnBZckk0VHE2MGRVQkNnM0c4SnhKeXMxM1NpQW41Snlwa2oK",
      "endpoints": [
        "https://github.com/mayankjonwal02/Tunnelpup/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}